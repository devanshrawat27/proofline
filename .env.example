# ---------------------------------------------------------------------------
# Goodsignal environment template.
# Copy to `.env` and fill in REAL values. NEVER commit real secrets.
# Values below are safe local-development placeholders (match docker-compose).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# --- PostgreSQL (matches infra/docker-compose.yml) ---
POSTGRES_USER=goodsignal
POSTGRES_PASSWORD=goodsignal
POSTGRES_DB=goodsignal
DATABASE_URL=postgresql://goodsignal:goodsignal@localhost:5432/goodsignal?schema=public

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=goodsignal
S3_SECRET_KEY=goodsignal
S3_BUCKET=goodsignal-documents
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Goodsignal <no-reply@goodsignal.local>"

# --- Auth / sessions ---
SESSION_COOKIE_NAME=goodsignal_session
# 32+ byte random secret. Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-please-generate-a-real-48-byte-secret
SESSION_TTL_HOURS=168

# --- Web / API URLs / CORS ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js; NEXT_PUBLIC_* are exposed to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API base URL (use the internal service URL in production).
API_INTERNAL_URL=http://localhost:4000

# --- AI extraction (provider-agnostic; provider=gemini) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=3

# --- Observability ---
LOG_LEVEL=debug
